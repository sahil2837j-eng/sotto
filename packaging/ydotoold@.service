[Unit]
Description=ydotoold for Sotto (root daemon, user-owned socket)
Documentation=https://github.com/sahil2837j-eng/sotto
After=local-fs.target

[Service]
# The socket lives in /run, not /run/user: logind recreates the user runtime
# directory at login, which unlinks a socket the daemon is still bound to.
# The client finds this path through YDOTOOL_SOCKET (set by dictate).
ExecStart=/usr/bin/ydotoold --socket-path=/run/ydotoold-__UID__.socket --socket-perm=0600 --socket-own=__UID__:__GID__
Restart=always
RestartSec=2
# no sandboxing: it must hold /dev/uinput open

[Install]
WantedBy=multi-user.target
