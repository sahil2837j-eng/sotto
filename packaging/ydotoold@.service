[Unit]
Description=ydotoold for WhisperQuill (root, user-owned socket)
Documentation=https://github.com/sahil2837j-eng/whisperquill
After=local-fs.target
Before=graphical.target

[Service]
# /run/user/<uid> only exists once the session is up; create it if we win the race
ExecStartPre=/bin/sh -c 'mkdir -p /run/user/%i && chown %i:%i /run/user/%i && chmod 0700 /run/user/%i'
ExecStart=/usr/bin/ydotoold --socket-path=/run/user/%i/.ydotool_socket --socket-perm=0600 --socket-own=%i:%i
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
