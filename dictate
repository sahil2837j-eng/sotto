#!/usr/bin/env bash
# Voice dictation toggle: press once to start listening, again to stop.
#
# While you are speaking, streamer.py transcribes the growing recording in
# ~3 s slices and types each slice into the focused window, so text appears
# live. Pressing the hotkey again finishes the tail. Takes that are too short
# for a live slice - and any run where streaming failed - fall back to
# transcribing the whole take after the fact.
#
# Every take gets its own wav under state/takes/, and the recorder's pid file
# records which wav belongs to it. That way starting a new take while the
# previous one is still being finished can never overwrite or delete the
# older take's audio.
set -u

BASE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
STATE="$BASE/state"
TAKES="$STATE/takes"
PIDF="$STATE/recording.pid"     # fields: <recorder pid><TAB><absolute wav path>
STREAM_PID="$STATE/stream.pid"
STREAM_STATE="$STATE/stream.json"
BUSY="$STATE/busy"
LAST_TAKE="$STATE/last_take.txt"
BOOST_FILE="$STATE/power_boost"
INDICATOR="$BASE/indicator.py"
INDICATOR_PID="$STATE/indicator.pid"
LOG="$BASE/dictate.log"
PY="$BASE/.venv/bin/python"
MAX_SECONDS=300
HOTKEY="Ctrl+Alt+Space"

mkdir -p "$STATE" "$TAKES"

# ydotool talks to the daemon through a socket. The installer puts it at
# /run/ydotoold-<uid>.socket, outside /run/user, because logind recreates
# the session directory at login and a socket inside it silently disappears
# (the daemon keeps running, the client can no longer connect).
if [[ -z "${YDOTOOL_SOCKET:-}" ]]; then
    for sock in "/run/ydotoold-$(id -u).socket" /run/ydotoold.socket \
                "/run/user/$(id -u)/.ydotool_socket" /tmp/.ydotool_socket; do
        if [[ -S "$sock" ]]; then
            export YDOTOOL_SOCKET="$sock"
            break
        fi
    done
fi

log()  { printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$LOG"; }
notify() { notify-send -u "${3:-normal}" -t "${4:-6000}" "Voice dictation" "${2:-$1}" 2>/dev/null || true; }
sound() { pw-play "$BASE/sounds/$1.wav" >/dev/null 2>&1 & }

# ---------- listening strip ----------
# Best effort: no layer-shell or no GTK, no strip. Dictation never depends on it.
layer_shell_lib() {
    local p
    for p in /usr/lib/libgtk4-layer-shell.so.0 \
             /usr/lib/*/libgtk4-layer-shell.so.0 \
             /usr/lib64/libgtk4-layer-shell.so.0; do
        [[ -e "$p" ]] && { printf '%s' "$p"; return 0; }
    done
    ldconfig -p 2>/dev/null | awk '/libgtk4-layer-shell\.so\.0/ {print $NF; exit}'
}

start_indicator() {
    [[ "${SOTTO_INDICATOR:-1}" == "0" ]] && return 0
    [[ -f "$INDICATOR" ]] || return 0
    command -v python3 >/dev/null 2>&1 || return 0
    stop_indicator
    # Python's GTK pulls in libwayland first; preloading the layer-shell
    # library is the documented fix for gtk_layer_init_for_window failing.
    local lib
    lib=$(layer_shell_lib)
    if [[ -n "$lib" ]]; then
        LD_PRELOAD="$lib" python3 "$INDICATOR" --pid "$1" --wav "$2" >/dev/null 2>&1 &
    else
        python3 "$INDICATOR" --pid "$1" --wav "$2" >/dev/null 2>&1 &
    fi
    echo $! > "$INDICATOR_PID"
}

stop_indicator() {
    [[ -f "$INDICATOR_PID" ]] || return 0
    local ipid
    ipid=$(cat "$INDICATOR_PID" 2>/dev/null)
    [[ -n "$ipid" ]] && kill -TERM "$ipid" 2>/dev/null
    rm -f "$INDICATOR_PID"
}

pid_alive() { kill -0 "$1" 2>/dev/null; }

# PIDF line is "<pid>\t<wav path>". Old single-field lines are still accepted.
recording_pid() {
    [[ -f "$PIDF" ]] || return 1
    local pid
    pid=$(cut -f1 "$PIDF" 2>/dev/null)
    [[ -n "$pid" ]] || return 1
    pid_alive "$pid" || return 1
    printf '%s' "$pid"
}

recording_wav() {
    [[ -f "$PIDF" ]] || return 1
    local w
    w=$(cut -f2 "$PIDF" 2>/dev/null)
    [[ -n "$w" ]] || return 1
    printf '%s' "$w"
}

# The streamer belongs to one take. A single global stream.pid is not enough:
# starting a new take overwrites it, and the previous take's stop would then
# kill the new streamer (or the old streamer would delete the new pid file).
# The pidfile therefore carries the streamer as its third field.
recording_streamer_pid() {
    [[ -f "$PIDF" ]] || return 1
    local spid
    spid=$(cut -f3 "$PIDF" 2>/dev/null)
    [[ -n "$spid" ]] || return 1
    pid_alive "$spid" || return 1
    printf '%s' "$spid"
}

stream_pid() {
    [[ -f "$STREAM_PID" ]] || return 1
    local pid
    pid=$(cat "$STREAM_PID" 2>/dev/null)
    [[ -n "$pid" ]] || return 1
    pid_alive "$pid" || return 1
    printf '%s' "$pid"
}

# ---- power-profile boost ----------------------------------------------------
# "power-saver" pins the CPU at ~0.8 GHz instead of 3.6 GHz, which makes
# Whisper about 3x slower (measured: 10.8s vs 3.4s for the same clip). Because
# transcription now runs *during* recording, the profile is raised for the
# whole take and put back when it ends. The marker file makes boost/restore
# work across the two separate hotkey presses (start process vs stop process),
# and restore only fires if nothing else changed the profile in between.
PPCTL=$(command -v powerprofilesctl || true)

boost_profile() {
    [[ -n "$PPCTL" ]] || return 0
    [[ -f "$BOOST_FILE" ]] && return 0
    local cur
    cur=$("$PPCTL" get 2>/dev/null || true)
    if [[ "$cur" == "power-saver" ]] && "$PPCTL" set balanced >/dev/null 2>&1; then
        printf '%s' "$cur" > "$BOOST_FILE"
        log "boost: $cur -> balanced for dictation"
    fi
}

restore_profile() {
    [[ -n "$PPCTL" && -f "$BOOST_FILE" ]] || return 0
    local orig cur
    orig=$(cat "$BOOST_FILE" 2>/dev/null || true)
    cur=$("$PPCTL" get 2>/dev/null || true)
    if [[ -n "$orig" && "$cur" == "balanced" ]]; then
        "$PPCTL" set "$orig" >/dev/null 2>&1 || true
        log "boost: restored profile '$orig'"
    else
        log "boost: profile now '$cur', leaving it (changed outside dictation)"
    fi
    rm -f "$BOOST_FILE"
}

stop_recording() {
    local pid="$1"
    kill -TERM "$pid" 2>/dev/null
    for _ in $(seq 1 60); do
        pid_alive "$pid" || break
        sleep 0.1
    done
    kill -KILL "$pid" 2>/dev/null
}

# Ask one take's streamer to finish the last slice and exit. Callers pass the
# pid they read from that take's pidfile; an explicit empty value must not fall
# back to the global file, which may belong to a newer take.
stop_streamer() {
    local spid
    if [[ $# -gt 0 ]]; then
        spid="$1"
    else
        spid=$(stream_pid) || return 0
    fi
    [[ -n "$spid" ]] || return 0
    kill -TERM "$spid" 2>/dev/null
    for _ in $(seq 1 300); do
        pid_alive "$spid" || break
        sleep 0.2
    done
    kill -KILL "$spid" 2>/dev/null
    if [[ "$(cat "$STREAM_PID" 2>/dev/null)" == "$spid" ]]; then
        rm -f "$STREAM_PID"
    fi
}

# ---------- start ----------
if ! pid=$(recording_pid); then
    # A stop can still be waiting for the previous streamer to type its tail.
    # Refuse a second take until that finishes; otherwise two streamers type
    # into the same focused window and the words interleave.
    if [[ -f "$BUSY" ]]; then
        bpid=$(cat "$BUSY" 2>/dev/null)
        if [[ -n "$bpid" ]] && pid_alive "$bpid"; then
            notify "Still finishing the last take — one moment."
            exit 0
        fi
        rm -f "$BUSY"
    fi

    # Take the pidfile out of circulation first so a stop that races us here
    # sees "no take" instead of acting on a wav we are about to replace.
    rm -f "$PIDF"

    wav="$TAKES/rec-$(date +%s)-$$.wav"
    rm -f "$STREAM_STATE" "$LAST_TAKE"

    pw-record --rate 16000 --channels 1 --format s16 "$wav" >/dev/null 2>&1 &
    pid=$!
    printf '%s\t%s\n' "$pid" "$wav" > "$PIDF"
    sleep 0.7
    if ! pid_alive "$pid"; then
        log "start: pw-record died immediately"
        rm -f "$PIDF" "$wav"
        notify "Couldn't start the microphone."
        exit 1
    fi

    # Live transcription runs while recording, so give the CPU headroom for the
    # whole take; restore_profile puts it back when the take ends.
    boost_profile

    # Safety net: never leave the mic open.
    (
        sleep "$MAX_SECONDS"
        if pid_alive "$pid"; then
            log "start: safety timeout after ${MAX_SECONDS}s, stopping"
            kill -TERM "$pid" 2>/dev/null
            restore_profile
        fi
    ) >/dev/null 2>&1 &
    disown

    "$PY" "$BASE/streamer.py" "$wav" >>"$LOG" 2>&1 &
    spid=$!
    echo "$spid" > "$STREAM_PID"
    # Record the streamer on this take, not just globally.
    printf '%s\t%s\t%s\n' "$pid" "$wav" "$spid" > "$PIDF"
    sleep 0.5
    if ! pid_alive "$spid"; then
        log "start: streamer did not start - will transcribe the whole take on stop"
        restore_profile
    fi

    log "start: recording pid=$pid streamer=$spid wav=$wav"
    start_indicator "$pid" "$wav"
    sound start
    exit 0
fi

# ---------- stop ----------
# Mark the take as finishing so a new hotkey press cannot start a second
# streamer while this one is typing its tail. The lock records our PID; the
# next start clears it if this process died before its EXIT trap ran.
printf '%s\n' "$$" > "$BUSY"
trap 'rm -f "$BUSY"' EXIT

# Claim this take's own wav and streamer before any waiting. A newer take that
# starts while we finish will use different files, so nothing here can touch it.
wav=$(recording_wav || printf '%s' "$STATE/recording.wav")
spid=$(recording_streamer_pid || true)
sound stop
stop_indicator
stop_recording "$pid"
rm -f "$PIDF"
stop_streamer "$spid"

# Read what the live pass produced (status/word count/language).
status=""; words=0; lang="?"
if [[ -f "$STREAM_STATE" ]]; then
    read -r status words lang < <("$PY" -c '
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    d = {}
print("%s %s %s" % (d.get("status", ""), int(d.get("words", 0) or 0), d.get("lang") or "?"))
' "$STREAM_STATE" 2>/dev/null) || true
fi
words=${words:-0}

if [[ "$words" -gt 0 ]]; then
    # Live path: the text was already typed into your window as you spoke.
    restore_profile
    log "stop: live path words=$words lang=$lang status=$status"
    rm -f "$wav"
    exit 0
fi

# ---- fallback: nothing was typed live, transcribe the whole take now ----
size=$(stat -c %s "$wav" 2>/dev/null || echo 0)
dur=$(ffprobe -v error -show_entries format=duration -of default=nw=1:nk=1 "$wav" 2>/dev/null || echo 0)
log "stop: live pass produced nothing (size=$size dur=${dur}s); full-take fallback"
if (( size < 20000 )) || awk "BEGIN{exit !(${dur:-0} < 0.6)}"; then
    log "stop: audio too short (${dur}s)"
    notify "Too short — hold the thought for half a second or more."
    rm -f "$wav"
    restore_profile
    exit 0
fi

log "stop: transcribing (${dur}s of audio)"

# Transcribe this take in place. It already has a unique name, so a newer
# take recording at the same time is unaffected.
boost_profile
text=$("$PY" "$BASE/transcribe.py" "$wav" 2>>"$LOG")
rc=$?
rm -f "$wav"
restore_profile

if [[ $rc -ne 0 ]]; then
    if [[ $rc -eq 3 ]]; then
        log "stop: no speech recognised"
        notify "Heard nothing recognisable."
        exit 0
    fi
    log "stop: transcription error rc=$rc"
    notify "Transcription failed — see $LOG" "" critical 10000
    exit 1
fi
if [[ -z "$text" ]]; then
    log "stop: empty result"
    notify "Heard nothing recognisable."
    exit 0
fi

log "stop: inserted '$text'"
exit 0
